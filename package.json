{
  "name": "aplicotizaciones2",
  "version": "2.0.0",
  "description": "Backend de cotizaciones (Bolivia): oficial, paralelo, monedas vecinas, oro, UFV, inflación, billeteras y bancos",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "recolector": "node src/recolector.js",
    "notificador": "node src/notificador.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "datos:ficticios": "node scripts/sembrarDatosFicticios.js",
    "datos:borrar-ficticios": "node scripts/sembrarDatosFicticios.js --borrar"
