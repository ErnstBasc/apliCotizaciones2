NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aquí
DB_NAME=aplicotizaciones2

# Vigencia del caché por tipo de dato, en minutos. 0 = sin caché. Se admiten decimales.
CACHE_MONEDAS_MIN=10
CACHE_OFICIAL_MIN=60
CACHE_PARALELO_MIN=10
CACHE_INDICADORES_MIN=60
CACHE_BILLETERAS_MIN=10
CACHE_BANCOS_MIN=30

# Recolector (npm run recolector): cada cuántos minutos consulta cada fuente. 0 = esa tarea queda desactivada.
RECOLECTOR_PARALELO_MIN=15
RECOLECTOR_BILLETERAS_MIN=15
RECOLECTOR_BANCOS_MIN=60
RECOLECTOR_OFICIAL_MIN=60
RECOLECTOR_INDICADORES_MIN=360
RECOLECTOR_MONEDAS_MIN=360

# Orígenes permitidos por CORS, separados por coma. Vacío = ninguno (el frontend va en el mismo origen).
CORS_ORIGINS=
