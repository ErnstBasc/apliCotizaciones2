NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aquí
DB_NAME=aplicotizaciones2

# Vigencia del caché por tipo de dato, en minutos. 0 = sin caché. Se admiten decimales.
CACHE_MONEDAS_MIN=10
CACHE_OFICIAL_MIN=60
CACHE_PARALELO_MIN=10
CACHE_INDICADORES_MIN=60
CACHE_BILLETERAS_MIN=10
CACHE_BANCOS_MIN=30

# Recolector (npm run recolector): cada cuántos minutos consulta cada fuente. 0 = esa tarea queda desactivada.
RECOLECTOR_PARALELO_MIN=15
RECOLECTOR_BILLETERAS_MIN=15
RECOLECTOR_BANCOS_MIN=60
RECOLECTOR_OFICIAL_MIN=60
RECOLECTOR_INDICADORES_MIN=360
RECOLECTOR_MONEDAS_MIN=360

# Orígenes permitidos por CORS, separados por coma. Vacío = ninguno (el frontend va en el mismo origen).
CORS_ORIGINS=


# --- Cuentas de usuario ---
# Secreto para firmar las sesiones (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si falta, en desarrollo se usa uno temporal (las sesiones se cierran al reiniciar); en producción es obligatorio.
JWT_SECRET=
# Días que dura una sesión abierta
SESION_DIAS=7
# Dirección pública del sitio: se usa para armar los enlaces de los correos
APP_URL=http://localhost:3000
# Cómo se envían los correos: "consola" (los imprime en la terminal; sirve para desarrollar) o "smtp" (envío real)
MAIL_MODO=consola
# --- Solo si MAIL_MODO=smtp. Ejemplo con Gmail (necesita verificación en dos pasos y una "contraseña de aplicación" de 16 letras;
#     NO uses tu contraseña normal). Cuenta Google → Seguridad → Contraseñas de aplicaciones.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SEGURO=true
# SMTP_USUARIO=tu_cuenta@gmail.com
# SMTP_CLAVE=abcdefghijklmnop
# MAIL_FROM=apliCotizaciones <tu_cuenta@gmail.com>

# --- Alertas ---
# Máximo de alertas por usuario y horas de espera antes de repetir el aviso de una misma alerta
ALERTAS_MAX=3
ALERTAS_ENFRIAMIENTO_H=12
# Cada cuántos minutos el notificador (npm run notificador) revisa las alertas
NOTIFICADOR_MIN=5
